# Firebase Client SDK Configuration (ambil dari Firebase Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aplikasi-hris-sederhana.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aplikasi-hris-sederhana
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aplikasi-hris-sederhana.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Opsional / Recommended untuk Server Actions dan Seeder otomatis)
